{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hadas-toda.co.il/schemas/intake/v1/eval-gold-extract.schema.json",
  "title": "Extractor gold-set case",
  "description": "One labeled extractor case (one line of eval/gold/extract/*.jsonl). Used for extractor unit tests, the provider benchmark, and regression tests created from adversarial-user findings. Scoring compares the extractor output AFTER code validation (evidence check, type parsing) with 'expected'. Owner: evaluation engineer (role 11); clinical labels spot-checked by Hadas. Synthetic only in v1 (D-07): no real conversations in any set.",
  "type": "object",
  "required": [
    "case_id",
    "tags",
    "source",
    "content_versions",
    "input",
    "expected"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{3,64}$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "multi_info_first_message",
          "hebrew_number_words",
          "slang_typos",
          "yes_no_in_context",
          "dont_know",
          "declined",
          "correction",
          "contradiction",
          "faq",
          "meta_question",
          "clinical_question",
          "off_topic",
          "injection",
          "red_flag_explicit",
          "red_flag_disguised",
          "red_flag_negative",
          "non_hebrew",
          "subject_self",
          "subject_child",
          "subject_other_adult",
          "gendered_variants",
          "mixed_language",
          "long_message",
          "empty_signal",
          "volunteered_short_fact",
          "failed_extraction_followup",
          "masked_identifier",
          "minor_self",
          "non_parent_reporter",
          "screen_choice"
        ]
      }
    },
    "source": {
      "enum": [
        "synthetic",
        "persona_run",
        "adversarial_finding"
      ]
    },
    "content_versions": {
      "type": "object",
      "required": [
        "slot_catalog",
        "red_flags",
        "faq"
      ],
      "properties": {
        "slot_catalog": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "red_flags": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "faq": {
          "$ref": "common.schema.json#/$defs/semver"
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": [
        "last_assistant_message",
        "asked_slot_ids",
        "case_state",
        "user_message"
      ],
      "properties": {
        "last_assistant_message": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1500
            },
            {
              "type": "null"
            }
          ]
        },
        "asked_slot_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/slotId"
          }
        },
        "case_state": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/slotId"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "status",
              "value"
            ],
            "properties": {
              "status": {
                "$ref": "common.schema.json#/$defs/slotStatus"
              },
              "value": {
                "$ref": "common.schema.json#/$defs/slotValue"
              }
            },
            "additionalProperties": false
          }
        },
        "user_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pending_messages": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 2000
          },
          "description": "Messages whose extraction failed earlier (critic F1)."
        }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": [
        "slot_updates",
        "must_not_fill",
        "red_flag_ids",
        "must_not_flag"
      ],
      "properties": {
        "slot_updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot_id",
              "status"
            ],
            "properties": {
              "slot_id": {
                "$ref": "common.schema.json#/$defs/slotId"
              },
              "status": {
                "enum": [
                  "filled",
                  "unknown",
                  "declined",
                  "conflicting"
                ]
              },
              "value": {
                "$ref": "common.schema.json#/$defs/slotValue"
              },
              "acceptable_values": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/slotValue"
                },
                "description": "Alternatives also scored as correct (e.g. 3 or 3.5)."
              },
              "is_correction": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "must_not_fill": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/slotId"
          },
          "description": "Filling any of these is a false fill (the old system's failure class); weighted heavily."
        },
        "red_flag_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/entityId"
          }
        },
        "must_not_flag": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/entityId"
          }
        },
        "user_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "faq",
                  "clinical",
                  "other"
                ]
              },
              "faq_id": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/entityId"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "signals": {
          "type": "object",
          "properties": {
            "wants_to_end": {
              "type": "boolean"
            },
            "wants_human": {
              "type": "boolean"
            },
            "off_topic": {
              "type": "boolean"
            },
            "non_hebrew": {
              "type": "boolean"
            },
            "injection_suspected": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "label_note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
