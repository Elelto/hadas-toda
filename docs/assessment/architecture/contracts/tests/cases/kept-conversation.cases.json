    { "id": "kc.ok.access_log_failed_login", "schema": "kept-conversation.schema.json#/$defs/accessLogEntry", "base": "access_view", "expect": "valid", "source": "D-01b, gate 1 (draft 3.3)", "patch": [{ "op": "replace", "path": "/action", "value": "login_failed" }, { "op": "remove", "path": "/kept_id" }, { "op": "replace", "path": "/second_factor", "value": "totp_failed" }] },
    { "id": "kc.D01b.session_id", "base": "kept", "expect": "invalid", "error": "additionalProperties", "source": "D-01b, gate 1 (draft 3.3): no linking ids", "patch": [{ "op": "add", "path": "/session_id", "value": "sess_AAAAAAAAAAAAAAAA" }] },
    { "id": "kc.D01b.lead_ref", "base": "kept", "expect": "invalid", "error": "additionalProperties", "source": "D-01b, gate 1 (draft 3.3): no linking ids", "patch": [{ "op": "add", "path": "/lead_ref", "value": "K7Q-2M" }] },
