    { "id": "kc.D01b.red_flag_outcome", "base": "kept", "expect": "invalid", "error": "/outcome/maximum", "source": "D-01b, gate 1 (draft 3.3): never after a red flag", "patch": [{ "op": "replace", "path": "/outcome", "value": 5 }] },
    { "id": "kc.D01b.red_flags_field", "base": "kept", "expect": "invalid", "error": "additionalProperties", "source": "D-01b, gate 1 (draft 3.3)", "patch": [{ "op": "add", "path": "/red_flags", "value": [] }] },
    { "id": "kc.D01b.other_adult", "base": "kept", "expect": "invalid", "error": "/relation/enum", "source": "D-01b, gate 1 (draft 3.3) + legal: only about oneself or one's own child", "patch": [{ "op": "replace", "path": "/relation", "value": "other_adult" }] },
    { "id": "kc.D01b.whatsapp", "base": "kept", "expect": "invalid", "error": "/channel/const", "source": "D-01b, gate 1 (draft 3.3): web only in v1", "patch": [{ "op": "replace", "path": "/channel", "value": "whatsapp" }] },
    { "id": "kc.D01b.name_mask_incomplete", "base": "kept", "expect": "invalid", "error": "/name_mask/properties/status/const", "source": "D-01b, gate 1 (draft 3.3): masking fails safe, nothing is kept", "patch": [{ "op": "replace", "path": "/name_mask/status", "value": "pattern_slow" }] },
    { "id": "kc.D01b.no_name_mask", "base": "kept", "expect": "invalid", "error": "required", "source": "D-01b, gate 1 (draft 3.3)", "patch": [{ "op": "remove", "path": "/name_mask" }] },
    { "id": "kc.D01b.fixed_text_copied", "base": "kept", "expect": "invalid", "error": "/allOf/2/then/not", "source": "D-01b, gate 1 (draft 3.3): fixed texts by reference only", "patch": [{ "op": "add", "path": "/turns/0/text", "value": "על מי הפנייה?" }] },
    { "id": "kc.D01b.user_turn_with_origin", "base": "kept", "expect": "invalid", "error": "/allOf/0/then/not", "source": "D-01b, gate 1 (draft 3.3)", "patch": [{ "op": "add", "path": "/turns/2/origin", "value": "generated" }] },
    { "id": "kc.D01b.no_turns", "base": "kept", "expect": "invalid", "error": "/turns/minItems", "source": "D-01b, gate 1 (draft 3.3)", "patch": [{ "op": "replace", "path": "/turns", "value": [] }] },
    { "id": "kc.D01b.view_without_second_factor", "schema": "kept-conversation.schema.json#/$defs/accessLogEntry", "base": "access_view", "expect": "invalid", "error": "/second_factor/const", "source": "D-01b, gate 1 (draft 3.3): 2FA before any content", "patch": [{ "op": "replace", "path": "/second_factor", "value": "totp_failed" }] },
    { "id": "kc.D01b.view_without_kept_id", "schema": "kept-conversation.schema.json#/$defs/accessLogEntry", "base": "access_view", "expect": "invalid", "error": "required", "source": "D-01b, gate 1 (draft 3.3): every view names what was read", "patch": [{ "op": "remove", "path": "/kept_id" }] },
    { "id": "kc.D01b.ai_reader", "schema": "kept-conversation.schema.json#/$defs/accessLogEntry", "base": "access_view", "expect": "invalid", "error": "/reader/enum", "source": "D-01b, gate 1 (draft 3.3) + D-07: no model and no AI assistant reads kept conversations", "patch": [{ "op": "replace", "path": "/reader", "value": "ai_assistant" }] }
